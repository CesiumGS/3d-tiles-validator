{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "outDir": "./build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
        
    "rootDir": ".",

    //-----------------------------------------------------------------------
    // TODO This was suddenly necessary. Clean this up.
    "ignoreDeprecations": "6.0",
    "types": [
      "node",
      "@types/jasmine"
    ],
    //-----------------------------------------------------------------------

    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "declaration": true,
    "declarationMap": true,
    "lib": [
      "es2021",
      "dom"
    ]
  },
  "include": ["src/**/*", "specs/**/*"],
  "exclude": ["node_modules"]
}
